<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="oem_heading_sensor_gazebo" params="name:=heading update_rate:=5">
    <gazebo reference="${namespace}/${name}">
      <sensor type="imu" name="${namespace}_${name}_imu">
        <always_on>1</always_on>
        <update_rate>${update_rate}</update_rate>
        <topic>${namespace}/sensors/${name}/data</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
          </angular_velocity>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
